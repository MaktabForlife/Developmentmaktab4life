{
  "name": "rebootworker",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-01",
  "keep_vars": true,
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "maktab4lifemedia"
    }
  ],
  "env": {
    "development": {
      "name": "devrebootworker",
      "r2_buckets": [
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "maktab4lifemedia"
        }
      ],
      "ratelimits": [
        {
          "name": "AUTH_LOGIN_RATE_LIMITER",
          "namespace_id": "100101",
          "simple": {
            "limit": 5,
            "period": 60
          }
        }
      ]
    }
  },
  "ratelimits": [
    {
      "name": "AUTH_LOGIN_RATE_LIMITER",
      "namespace_id": "100100",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
